! krestore
! KRESTORE

! Description:
! Selects the keypoint selection component created by KBACKUP.

! Arguments:
! -

! Local parameters:
! ar20: parType
! ar21: cmType
! ar22: expectedType

! Global parameters:
! KBACKUP_


ar22 = 6

*get,ar20,parm,KBACKUP_,type

*if,ar20,ne,0,then
  *msg,warn
KRESTORE error: invalid backup parameter type (expected scalar).%/&
KRESTORE command is ignored.
  *return,-1
*endif

*if,KBACKUP_,eq,0,then
  *msg,warn
KRESTORE error: no backed up selection to restore.%/&
KRESTORE command is ignored.
  *return,-1
*endif

*get,ar21,comp,KBACKUP_CM_%KBACKUP_%,type
*if,ar21,ne,ar22,then
  *msg,warn
KRESTORE warning: backed up selection component already deleted.%/&
No selection operation performed.
  KBACKUP_ = KBACKUP_-1
  *return,-1
*endif

! Select & delete last backed up named selection component
cmsel,s,KBACKUP_CM_%KBACKUP_%
cmdele,KBACKUP_CM_%KBACKUP_%

! Update backup counter
KBACKUP_ = KBACKUP_-1

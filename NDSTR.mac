! ndstr , firstNode , epoolOpt , output
! NDSTR , ARG1      , ARG2     , ARG3

! Description:
! Generates a list with the number of the selected nodes in a specific order. One node is given
! as reference to be used as first in the sequence. Subsequent nodes are selected by adjacency
! through elements in common.

! Arguments:
! ARG1: firstNode  -  number of the first node
! ARG2: epoolOpt   -  adjacency through element selection option:
!                       [0]     from full (S);
!                       [1]     reselect (R);
!                       [<STR>] name of element selection component to use as pool;
! ARG3: output     -  name of output array parameter (defaults to 'NDSTR_ARR_nodeList')

! Local parameters:
! ar20: parType
! ar21: nselStatus
! ar22: selectMode
! ar23: outputParm
! ar24: cmType
! ar30: COMPN_pool
! ar31: COMPN_processed
! ar32: nodePoolCount
! ar33: nthNode
! ar34: adjacentNode
! ar40: COMPE_pool

! Output parameters:
! %ARG3% (defaults to 'NDSTR_ARR_nodeList')


! Parse inputs
*if,ARG1,le,0,then
  *msg,error
NDSTR error: invalid node number.%/&
NDSTR command ignored.
  *return,-1
*endif

*get,ar21,node,ARG1,nsel
*if,ar21,ne,1,then
  *msg,error
NDSTR error: first node does not exist or is unselected.%/&
NDSTR command ignored.
  *return,-1
*endif

ar22 = 0
*get,ar20,parm,ARG2,type
*if,ar20,eq,0,then
  ! Numeric value: 'from full' or 'reselect'
  *if,ARG2,eq,1,then
    ar22 = 1
  *endif
*elseif,ar20,eq,3,then
  ! String: element selection component
  *get,ar24,comp,%ARG2%,type
  *if,ar24,eq,2,then
    ar22 = 2
  *else
    *msg,error
NDSTR error: when ARG2 is a string it is expected to be the name of an element selection component.%/&
NDSTR command ignored.
    *return,-1
  *endif
*endif

ar23 = 'NDSTR_ARR_nodeList'
*get,ar20,parm,ARG3,type
*if,ar20,eq,3,then
  ar23 = ARG3
*endif

! Prepare environment
cm,ar30,node
*get,ar32,node,,count
*del,%ar23%,,nopr
*dim,%ar23%,,ar32

*if,ar22,eq,0,then
  esel,all
*elseif,ar22,eq,1,then
  ! Use current selection -- nothing to do
*elseif,ar22,eq,2,then
  cmsel,s,%ARG2%
*endif
cm,ar40,elem

nsel,s,node,,ARG1
cm,ar31,node

! Loop over nodes excluding reference one
%ar23%(1) = ARG1

*do,ar33,1,ar32-1,1

  ! Select next node through adjacent element
  cmsel , s , ar31
  esln  , s
  cmsel , r , ar40
  nsle  , s
  cmsel , r , ar30
  cmsel , u , ar31
  ar34 = ndnext(0)  ! TODO  'ndnext' can be replaced with 'nnear' to account for cases in which
                    !       there is node ambiguity, like for forks along the nodal path or
                    !       for elements with midside nodes

  ! Break if connectivity is lost
  *if,ar34,eq,0,then
    *msg,warn,%ar23%(ar33)
NDSTR warning: connectivity lost after node %I.%/&
Returned array of nodes might be incomplete.
    *exit
  *endif

  ! Increment processed nodes selection component & output array
  %ar23%(ar33+1) = ar34
  nsel,s,node,,ar34
  cmsel,a,ar31
  cm,ar31,node

*enddo

! Clean up
cmsel,s,ar40
cmdele,ar40
cmsel,s,ar30

! ndstr , firstNode , reselectElems
! NDSTR , ARG1      , ARG2

! Description:
! Generates a list with the number of the selected nodes in a specific order. One node is given
! as reference to be used as first in the sequence. Subsequent nodes are selected by adjacency
! through elements in common.

! Arguments:
! ARG1: firstNode      -  number of the first node
! ARG2: reselectElems  -  adjacency through element selection option:
!                            [0] from full (S);
!                            [1] reselect (R);

! Local parameters:
! ar20: COMPN_allNodes
! ar21: NodeCount
! ar22: NCount
! ar23: prevNode
! ar24: abortKey
! ar25: thisNode
! ar26: COMPN_processedNodes
! ar27: nthNode
! ar28: parType
! ar29: selectMode
! ar30: COMPE_prevElems

! Output parameters:
! NDSTR_ARR_NodeList


! Gerar componente com nós selecionados
cm,ar20,node
*get,ar21,node,,count
*del,NDSTR_ARR_NodeList,,nopr
*dim,NDSTR_ARR_NodeList,,ar21

! Obter tipo de seleção dos nós
*get,ar28,parm,ARG2,type
*if,ar28,ne,0,then
  ar29 = 0
*else
  ar29 = ARG2
*endif
*if,ar29,eq,1,then
  cm,ar30,elem
*endif

! Selecionar nó inicial
nsel,r,node,,ARG1
*get,ar22,node,,count

*if,ar22,eq,0,then
  ! ERRO: Nó inicial não faz parte dos nós selecionados
  *msg,warn,ARG1
WARNING: FIRST NODE (%I) DOES NOT BELONG TO SELECTED SET.

*else
  ! Armazenar número do primeiro nó no vetor de nós
  NDSTR_ARR_NodeList(1) = ARG1
  ! Criar componente de nós processados
  cm,ar26,node
  ar23 = ARG1
  ar24 = 0
  *do,ar27,1,ar21-1,1
    ! Verificar abortKey
    *if,ar24,eq,1,then
      ! Preencher vetor de número de nós com entrada nula (zero)
      NDSTR_ARR_NodeList(ar27+1) = 0
    *else
      ! Selecionar o nó prévio
      nsel,s,node,,ar23
      ! Selecionar o próximo nó (adjacente a elemento em comum)
      *if,ar29,eq,1,then
        cmsel,s,ar30
        esln,r,0
      *else
        esln,s,0
      *endif
      nsle,s,all
      cmsel,r,ar20
      cmsel,u,ar26
      ! Verificar se há nó selecionado
      *get,ar22,node,,count
      *if,ar22,eq,0,then
        ! Nenhum nó selecionado (perda de conectividade): ativar abortKey
        ar24                       = 1
        NDSTR_ARR_NodeList(ar27+1) = 0
        *msg,warn,ar23
WARNING: NODE CONNECTIVITY LOST AT NODE %I.
      *else
        ! Armazenar número do nó no vetor de nós
        *get,ar25,node,,num,min
        nsel,s,node,,ar25
        NDSTR_ARR_NodeList(ar27+1) = ar25
        ar23                       = ar25
        ! Atualizar componente de nós processados
        cmsel,a,ar26
        cm,ar26,node
      *endif
    *endif
  *enddo
*endif

! Excluir componente
*if,ar29,eq,1,then
  cmsel,s,ar30
  cmdele,ar30
*endif

! Retomar seleção inicial
cmsel,s,ar20

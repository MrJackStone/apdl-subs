! radslice , cmInput , r    , cmOutput
! RADSLICE , ARG1    , ARG2 , ARG3

! Descrption:
! Performs circular slicing of given areas using a cylinder centered at the working plane, with
! height measured along the Z axis.

! Arguments:
! ARG1: cmInput   -  name of area selection component containing areas to be sliced
! ARG2: r         -  slice radius
! ARG3: cmOutput  -  name of line selection component to be created to contain lines generated
!                    when performing the slicing operation

! Local parameters:
! ar20: maxCsys
! ar21: newCsys
! ar22: minZ
! ar23: maxZ
! ar24: cylinderHeight
! ar25: cylinderZcenter
! ar26: voluNum
! ar27: parType

! Global parameters (erased at the end of this subroutine):
! RADSLICE_COMPA_slicer


! Prepare environment
vbackup
csbackup

*get,ar20,cdsy,,num,max
ar21 = (ar20+1>11)
cswpla,ar21,cylin
csys,ar21

! Calculate slicer cylinder height
cmsel,s,%ARG1%
lsla,s
ksll,s
*get,ar22,kp,,mnloc,z
*get,ar23,kp,,mxloc,z
ar24 = (ar23-ar22>1)
ar25 = (ar23+ar22)/2

! Draw slicer cylinder
asel,none
vsel,none
wpoffs,,,ar25-ar24
cyl4,0,0,ARG2,,,,2*ar24
wpoffs,,,-(ar25-ar24)
cm,RADSLICE_COMPA_slicer,area
ar26 = vlnext(0)

! Slice areas
cmsel,s,RADSLICE_COMPA_slicer
cmsel,a,%ARG1%
asba,%ARG1%,RADSLICE_COMPA_slicer,,delete,keep

! Delete slicer volume, areas, lines, and keypoints
cmdele,RADSLICE_COMPA_slicer
vdele,ar26,,,1
cm,%ARG1%,area

! Create component: lines at sliced ring
*get,ar27,parm,ARG3,type
*if,ar27,eq,3,then
  cmsel,s,%ARG1%
  lsla,s
  lsel,r,loc,x,ARG2
  cm,%ARG3%,line
*endif

! Clean up
vrestore
csrestore
csdele,ar21
cmsel,a,%ARG1%

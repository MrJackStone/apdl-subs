! radslice , cmInput , r    , cmOutput
! RADSLICE , ARG1    , ARG2 , ARG3

! Descrption:
! Performs circular slicing of given areas using a cylinder centered at the working plane, with
! height measured along the Z axis.

! Arguments:
! ARG1: cmInput   -  name of area selection component containing areas to be sliced
! ARG2: r         -  slice radius
! ARG3: cmOutput  -  name of line selection component to be created to contain lines generated
!                    when performing the slicing operation. Defaults to:
!                      - 'RADSLICE_COMPL_output' for area slicing
!                      - 'RADSLICE_COMPA_output' for volume slicing

! Local parameters:
! ar20: parType
! ar21: maxZ
! ar22: minZ
! ar23: cmOutputName
! ar24: cylinderHeight
! ar25: cylinderZcenter
! ar26: voluNum
! ar27: cmInputType
! ar28: smType
! ar30: maxCsys
! ar31: newCsys

! Global parameters (erased at the end of this subroutine):
! RADSLICE_COMPA_slicer


! Parse inputs
*get,ar20,parm,ARG1,type
*if,ar20,ne,3,then
  *msg,error
RADSLICE error: expected ARG1 to be a string.%/&
RADSLICE command ignored.
  *return,-1
*endif

*get,ar27,comp,%ARG1%,type
*if,ar27,eq,8,then
  ar28 = 'AREA'
*elseif,ar27,eq,9,then
  ar28 = 'VOLU'
*else
  *msg,error,ar27
RADSLICE error: expected ARG1 to be the name of an AREA (8) or VOLUME (9) component, but got %I instead.%/&
RADSLICE command ignored.
  *return,-1
*endif

*get,ar20,parm,ARG3,type
*if,ar20,eq,3,then
  ar23 = ARG3
*elseif,ar28,eq,'AREA',then
  ar23 = 'RADSLICE_COMPL_output'
*elseif,ar28,eq,'VOLU',then
  ar23 = 'RADSLICE_COMPA_output'
*endif

! Prepare environment
vbackup
csbackup

*get,ar30,cdsy,,num,max
ar31 = (ar30+1>11)
cswpla,ar31,cylin
csys,ar31

! Calculate slicer cylinder height
cmsel,s,%ARG1%
*if,ar28,eq,'VOLU',then
  aslv,s
*endif
lsla,s
ksll,s
*get,ar22,kp,,mnloc,z
*get,ar21,kp,,mxloc,z
ar24 = (ar21-ar22>1)
ar25 = (ar21+ar22)/2

! Draw slicer cylinder
asel,none
vsel,none
wpoffs,,,ar25-ar24
cyl4,0,0,ARG2,,,,2*ar24
wpoffs,,,-(ar25-ar24)
cm,RADSLICE_COMPA_slicer,area
ar26 = vlnext(0)

! Slice solid model
cmsel,s,RADSLICE_COMPA_slicer
*if,ar28,eq,'AREA',then
  cmsel,a,%ARG1%
  asba,%ARG1%,RADSLICE_COMPA_slicer,,delete,keep
*elseif,ar28,eq,'VOLU',then
  cmsel,s,%ARG1%
  vsba,%ARG1%,RADSLICE_COMPA_slicer,,delete,keep
*endif

! Delete slicer entities
cmdele,RADSLICE_COMPA_slicer
vdele,ar26,,,1
cm,%ARG1%,%ar28%

! Create component: lines or areas at sliced ring
*if,ar28,eq,'AREA',then
  cmsel,s,%ARG1%
  lsla,s
  lsel,r,loc,x,ARG2
  cm,%ar23%,line
*elseif,ar28,eq,'VOLU',then
  cmsel,s,%ARG1%
  aslv,s
  asel,r,loc,x,ARG2
  cm,%ar23%,area
*endif

! Clean up
vrestore
csrestore
csdele,ar31
cmsel,a,%ARG1%

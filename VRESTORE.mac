! vrestore
! VRESTORE

! Description:
! Selects the volume selection component created by VBACKUP.

! Arguments:
! -

! Local parameters:
! ar20: parType
! ar21: cmType
! ar22: expectedType

! Global parameters:
! VBACKUP_


ar22 = 9

*get,ar20,parm,VBACKUP_,type

*if,ar20,ne,0,then
  *msg,warn
VRESTORE error: invalid backup parameter type (expected scalar).%/&
VRESTORE command is ignored.
  *return,-1
*endif

*if,VBACKUP_,eq,0,then
  *msg,warn
VRESTORE error: no backed up selection to restore.%/&
VRESTORE command is ignored.
  *return,-1
*endif

*get,ar21,comp,VBACKUP_CM_%VBACKUP_%,type
*if,ar21,ne,ar22,then
  *msg,warn
VRESTORE warning: backed up selection component already deleted.%/&
No selection operation performed.
  VBACKUP_ = VBACKUP_-1
  *return,-1
*endif

! Select & delete last backed up named selection component
cmsel,s,VBACKUP_CM_%VBACKUP_%
cmdele,VBACKUP_CM_%VBACKUP_%

! Update backup counter
VBACKUP_ = VBACKUP_-1
